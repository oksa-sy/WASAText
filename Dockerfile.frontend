# scarico immagine di Node.js e la chiama builder
FROM node:lts AS builder
# creo e imposta la cartella di lavoro
WORKDIR /app
# copio webui
COPY webui webui
# entro nella cartella
WORKDIR /app/webui
# installo le dipendenze con npm
RUN npm install
# installo un pacchetto specifico per evitare errori di compatibilità
RUN npm install @rollup/rollup-linux-arm64-gnu --save-optional
# eseguo compilatore vite per trasformare i file e comprimerli in dist
RUN npx vite build --mode production
# scarico immagine nginx
FROM nginx:stable
# copio file compilati nella cartella di Nginx
COPY --from=builder /app/webui/dist /usr/share/nginx/html
# istruzioni per nginx: ascoltare sulla porta 80, gestisce il router di vue e fa da tramite tra frontend e backend
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /session { proxy_pass http://backend:3000; } \
    location /users { proxy_pass http://backend:3000; } \
    location /conversations { proxy_pass http://backend:3000; } \
    location /groups { proxy_pass http://backend:3000; } \
    location /messages { proxy_pass http://backend:3000; } \
    location /images { proxy_pass http://backend:3000; } \
}' > /etc/nginx/conf.d/default.conf
# il contaner userà la porta 80
EXPOSE 80
# avvia nginx
CMD ["nginx", "-g", "daemon off;"]